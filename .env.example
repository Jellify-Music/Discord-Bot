# .env
# Copy this file to .env and fill in your Discord bot token
DISCORD_TOKEN=

DISCORD_CLIENT_ID=

# Optional: If you want to register commands to a specific guild for testing, set the guild ID here
DISCORD_GUILD_ID=

OPENAI_BASE_URL=

OPENAI_API_KEY=

OPENAI_MODEL=

OPENAI_ADDITIONAL_SYSTEM_PROMPTS=

# Optional: A GitHub token with Issues read/write access. Enables the /issue command
GITHUB_TOKEN=

# Optional: The repository /issue works against (defaults to Jellify-Music/App)
GITHUB_REPO_OWNER=

GITHUB_REPO_NAME=
